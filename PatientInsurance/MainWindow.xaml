<Window x:Class="PatientInsurance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PatientInsurance"
        Title="Patient Insurance"
        Height="840" Width="1440"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <local:ClaimStatusToBrushConverter x:Key="StatusToBrushConverter" />
        <local:RiskToBrushConverter x:Key="RiskToBrushConverter" />

        <!-- Fixed brand colors (status accents do not change with theme) -->
        <Color x:Key="BrandTealColor">#0F7B7B</Color>
        <Color x:Key="BrandNavyColor">#152238</Color>
        <Color x:Key="SuccessColor">#2E9E5B</Color>
        <Color x:Key="WarningColor">#E0A72E</Color>
        <Color x:Key="DangerColor">#D5544A</Color>
        <Color x:Key="InfoColor">#3E7CDB</Color>

        <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
        <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavyColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

        <!-- Theme-swappable brushes (REPLACED, not mutated, at runtime in MainWindow.xaml.cs -> ApplyTheme) -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7F9" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#152238" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#12000000" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F1F3F5" />
        <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#F7F9FA" />
        <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="GridRowHoverBrush" Color="#143E7CDB" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#14000000" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#1F3E7CDB" />

        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BrandNavyColor}" Offset="0" />
            <GradientStop Color="{StaticResource BrandTealColor}" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1A2233" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.14" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Resources>
                <VisualBrush x:Key="WatermarkBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                    <VisualBrush.Visual>
                        <TextBlock Text="Search…" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" Margin="10,0,0,0" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background" Value="{StaticResource WatermarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GridRowHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GridRowHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateRowBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="44" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GridRowHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" x:Name="SidebarBorder" Width="230" ClipToBounds="True"
                Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarContent" LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,28">
                    <TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
                    <TextBlock Text="Patient Insurance" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,20">
                    <Button x:Name="NavSettingsButton" Tag="Settings" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" />
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Margin="12,0">
                    <Button x:Name="NavDashboardButton" Tag="Dashboard" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" />
                            <TextBlock Text="Dashboard" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPatientsButton" Tag="Patients" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" />
                            <TextBlock Text="Patient Data" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSubmissionsButton" Tag="Submissions" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" />
                            <TextBlock Text="Current Submissions" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPredictorButton" Tag="Predictor" Style="{StaticResource SidebarNavButtonStyle}" Click="NavButton_Click" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="24" />
                            <TextBlock Text="Premium Predictor" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="32,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="HamburgerButton" Style="{StaticResource IconButtonStyle}" Click="HamburgerButton_Click" Margin="0,0,16,0">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Button>
                    <TextBlock x:Name="PageTitleText" Grid.Column="1" Text="Dashboard" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="2" Style="{StaticResource SearchBoxStyle}" Width="260" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" x:Name="ContentHost">

                <!-- Dashboard page -->
                <ScrollViewer x:Name="DashboardPage" Padding="32,24,32,40" Visibility="Visible">
                    <StackPanel>

                        <Grid x:Name="StatsGrid" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,20,0"
                                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource InfoBrush}">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Total Patients" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="PatientsValueText" Grid.Row="1" Style="{StaticResource StatValueStyle}" Text="0" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="+18 this week" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,20,0"
                                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandTealBrush}">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Active Policies" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="PoliciesValueText" Grid.Row="1" Style="{StaticResource StatValueStyle}" Text="0" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="+6 this week" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Margin="0,0,20,0"
                                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource WarningBrush}">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Pending Claims" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="ClaimsValueText" Grid.Row="1" Style="{StaticResource StatValueStyle}" Text="0" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="4 due today" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}"
                                    MouseEnter="OnCardMouseEnter" MouseLeave="OnCardMouseLeave" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource SuccessBrush}">
                                            <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Premium Collected" Style="{StaticResource StatLabelStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="PremiumValueText" Grid.Row="1" Style="{StaticResource StatValueStyle}" Text="$0" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="This month" Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="ContentGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="Recent Claims" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                    <DataGrid x:Name="ClaimsGrid" ItemsSource="{Binding RecentClaims}"
                                              Style="{StaticResource AppDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                              RowStyle="{StaticResource GridRowStyle}"
                                              CellStyle="{StaticResource GridCellStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding ClaimType}" Width="2*" />
                                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:C0}}" Width="*" />
                                            <DataGridTemplateColumn Header="Status" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                                                Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedOn, StringFormat={}{0:MMM d}}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Claims by Status" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                        <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <Canvas x:Name="ChartCanvas" Width="180" Height="180" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="CenterValueText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="Approved" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="● Approved" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="● Pending" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="● Review" Foreground="{StaticResource InfoBrush}" FontSize="11" Margin="0,0,12,0" />
                                            <TextBlock Text="● Denied" Foreground="{StaticResource DangerBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DashboardCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Upcoming Renewals" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                        <ItemsControl ItemsSource="{Binding UpcomingRenewals}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,14">
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding PlanName}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding RenewalDate}" Style="{StaticResource MutedTextStyle}" />
                                                        </Grid>
                                                        <ProgressBar Value="{Binding CoverageUsedPercentDisplay, Mode=OneWay}" Maximum="100" Height="6" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- Patient Data page (dummy) -->
                <Grid x:Name="PatientsPage" Margin="32,24" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="All Patients" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />
                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}">
                        <DataGrid x:Name="PatientsGrid"
                                  Style="{StaticResource AppDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  CellStyle="{StaticResource GridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Policy Number" Binding="{Binding PolicyNumber}" Width="*" />
                                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Current Submissions page (dummy) -->
                <Grid x:Name="SubmissionsPage" Margin="32,24" Visibility="Collapsed">
                    <Border Style="{StaticResource DashboardCardStyle}" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                       Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="No current submissions" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="New patient submissions will show up here once they come in." Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Premium Predictor page (machine learning) -->
                <ScrollViewer x:Name="PredictorPage" Padding="32,24,32,40" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Predict a patient's yearly medical cost" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="An ML.NET model trained on dummy insurance data estimates the yearly cost, a fair monthly premium and the risk level."
                                   Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20" />

                        <Grid x:Name="PredictorGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Inputs -->
                            <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,20,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Patient details" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="AGE (18–100)" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox x:Name="AgeInput" Text="35" Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="BMI (10–70)" Style="{StaticResource FormLabelStyle}" />
                                            <TextBox x:Name="BmiInput" Text="26.5" Style="{StaticResource FormTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CHILDREN" Style="{StaticResource FormLabelStyle}" />
                                            <ComboBox x:Name="ChildrenInput" SelectedIndex="1" Style="{StaticResource FormComboBoxStyle}">
                                                <ComboBoxItem Content="0" />
                                                <ComboBoxItem Content="1" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="3" />
                                                <ComboBoxItem Content="4" />
                                                <ComboBoxItem Content="5" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="SEX" Style="{StaticResource FormLabelStyle}" />
                                            <ComboBox x:Name="SexInput" SelectedIndex="0" Style="{StaticResource FormComboBoxStyle}">
                                                <ComboBoxItem Content="Female" />
                                                <ComboBoxItem Content="Male" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="REGION" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox x:Name="RegionInput" SelectedIndex="0" Style="{StaticResource FormComboBoxStyle}">
                                        <ComboBoxItem Content="Northeast" Tag="northeast" />
                                        <ComboBoxItem Content="Northwest" Tag="northwest" />
                                        <ComboBoxItem Content="Southeast" Tag="southeast" />
                                        <ComboBoxItem Content="Southwest" Tag="southwest" />
                                    </ComboBox>

                                    <CheckBox x:Name="SmokerInput" Content="Smoker" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,20" />

                                    <Button x:Name="PredictButton" Click="PredictButton_Click" IsEnabled="False"
                                            Style="{StaticResource CardButtonStyle}" Background="{StaticResource BrandTealBrush}"
                                            Padding="20,12" Cursor="Hand" HorizontalAlignment="Stretch">
                                        <TextBlock Text="Predict cost" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                    </Button>
                                    <TextBlock x:Name="PredictErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!-- Results -->
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Prediction" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16" />

                                        <TextBlock x:Name="PredictionPlaceholderText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                                   Text="Fill in the patient details and press Predict cost." />

                                        <StackPanel x:Name="PredictionResultPanel" Visibility="Collapsed">
                                            <TextBlock Text="Expected yearly medical cost" Style="{StaticResource StatLabelStyle}" />
                                            <TextBlock x:Name="PredictedCostText" Style="{StaticResource StatValueStyle}" Margin="0,2,0,16" />

                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Suggested monthly premium" Style="{StaticResource StatLabelStyle}" />
                                                    <TextBlock x:Name="MonthlyPremiumText" FontSize="22" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Risk level" Style="{StaticResource StatLabelStyle}" />
                                                    <Border x:Name="RiskBadge" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                        <TextBlock x:Name="RiskText" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock x:Name="PredictionNoteText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings page -->
                <Grid x:Name="SettingsPage" Margin="32,24" Visibility="Collapsed">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                                <TextBlock Text="Choose how Patient Insurance looks on your device." Style="{StaticResource MutedTextStyle}" Margin="0,0,0,16" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LightThemeButton" Tag="Light" Click="ThemeButton_Click" Style="{StaticResource CardButtonStyle}"
                                            Margin="0,0,12,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{StaticResource InfoBrush}"
                                            BorderThickness="2" Padding="24,14" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="Light" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DarkThemeButton" Tag="Dark" Click="ThemeButton_Click" Style="{StaticResource CardButtonStyle}"
                                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="2" Padding="24,14" Cursor="Hand">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="Dark" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Notifications" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
                                <CheckBox Content="Email me about new claims" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
                                <CheckBox Content="SMS alerts for urgent submissions" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />
                                <CheckBox Content="Weekly summary report" IsChecked="True" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>